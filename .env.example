# Copie para o painel do provedor (Vercel) ou para um .env local NAO versionado.
# Nao grave valores reais de SEGREDO neste arquivo. A plataforma injeta PORT;
# nao fixe 8080 na nuvem.
#
# Legenda:
#   [SEGREDO]  deixe em branco aqui; preencha no painel do provedor.
#   [PADRAO]   valor sugerido (padrao de mercado). Ajustavel; ver docs/publicacao-checklist.md.
#   [DP-12]    provisorio: a constituicao pede avaliacao com exemplos antes de virar producao.

ASPNETCORE_ENVIRONMENT=Production
PORT=8080                           # [PADRAO] Vercel roteia para esta porta; o container escuta nela

# ================= Api.Agente =================
ConnectionStrings__Agente=          # [SEGREDO] Postgres Neon (base agente), com SSL Mode=Require
Conhecimento__McpUrl=               # URL do MCP da Api.RAG publicada, ex.: https://<rag>.vercel.app/mcp
OpenAI__ApiKey=                     # [SEGREDO] chave da OpenAI (rotacionar a atual antes de publicar)
OpenAI__Model=                      # [PADRAO] LLM de analise; sugestao de mercado: gpt-4o-mini (escolha sua)
Sofia__Chave=                       # [SEGREDO] chave de autenticacao do canal A2A SOFIA (ou use SOFIA_A2A_TOKEN)
SOFIA_A2A_TOKEN=                    # [SEGREDO] token Bearer de entrada A2A (skill sofia-a2a-autenticacao); prevalece sobre Sofia__Chave
Sofia__Url=                         # URL publica do proprio agente (Agent Card), ex.: https://<agente>.vercel.app

# ================= Api.RAG =================
ConnectionStrings__Rag=             # [SEGREDO] Postgres Neon (base rag, com extensao vector), SSL Mode=Require
Ingestao__Chave=                    # [SEGREDO] chave de ingestao (cabecalho X-Chave-Ingestao); gere 32+ bytes aleatorios
Ingestao__TamanhoMaximoBytes=4000000    # [PADRAO] 4 MB: abaixo do teto de 4,5 MB de corpo da Vercel
OpenAI__Endpoint=                   # vazio = endpoint padrao da OpenAI; preencha so se usar Azure/compativel

Embedding__Model=text-embedding-3-small  # [PADRAO] embedding mais barato da OpenAI
Embedding__Dimensao=1536            # [PADRAO] dimensao nativa do modelo -> coluna vector(1536) no Neon
Embedding__TopK=5                   # [DP-12] nº de evidencias por consulta
Embedding__Limiar=0.5               # [DP-12] similaridade de cosseno minima (0 a 1)
Embedding__TamanhoChunk=2000        # [DP-12] tamanho do chunk em CARACTERES (~500 tokens)
Embedding__Sobreposicao=200         # [DP-12] sobreposicao em caracteres (~10%)
